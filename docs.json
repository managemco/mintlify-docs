{
  "$schema": "https://mintlify.com/schema.json",
  "theme": "mint",
  "name": "docs",
  "colors": {
    "primary": "#927dff",
    "light": "#927dff",
    "dark": "#927dff"
  },
  "favicon": "/logo/logo.svg",
  "icons": {
    "library": "lucide"
  },
  "navigation": {
