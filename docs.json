                "group": "Cards & sealed products",
                "pages": [
                  "POST /search",
                  "GET /search/lookup",
                  "POST /search/lookup/bulk"
                ]
              },
              {
                "group": "Users",
                "pages": [
                  "POST /search/users"
                ]
              },
              {
                "group": "Hierarchy",
                "pages": [
                  "GET /search/hierarchy",
                  "POST /search/hierarchy/{game}",
                  "POST /search/hierarchy/{game}/{set}",
                  "POST /search/hierarchy/{game}/{set}/{type}"
                ]
              }
            ]
          },
          {
            "group": "Listings",
            "icon": "list",
            "pages": [
              "POST /listings",
              "POST /listings/seller/{id}",
              "POST /listings/item",
              "GET /listings/prices"
            ]
