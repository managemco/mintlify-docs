      {
        "tab": "Marketplace",
        "icon": "store",
        "openapi": "https://api.managem.co.uk/doc",
        "playground": "interactive",
        "groups": [
          {
            "group": "Search",
            "icon": "binoculars",
            "pages": [
              "marketplace/search-and-data",
